{
  "name": "@kelbie/hunch",
  "version": "0.11.0",
  "description": "Gut-check every pull request against plain-English rules and your agent skills, using TypeSafe's Jev.",
  "type": "module",
  "bin": {
    "hunch": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelbie/hunch.git"
  },
  "keywords": [
    "lint",
    "code-review",
    "jev",
    "typesafe",
    "agent-skills",
    "github-app"
  ],
  "dependencies": {
    "@ai-sdk/gateway": "4.0.85",
    "@clack/prompts": "1.8.1",
    "ai": "7.0.105",
    "commander": "^15.0.0",
    "oxc-parser": "0.150.0",
    "parse-diff": "0.12.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.8.0",
    "zod": "4.6.5"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/sync-readme.mjs && tsup --config tsup.config.ts",
    "prepack": "bun run build"
  }
}
