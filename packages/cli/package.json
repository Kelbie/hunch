{
  "name": "@kelbie/hunch",
  "version": "0.1.0",
  "description": "Gut-check every pull request against plain-English rules and your agent skills, using TypeSafe's Jev.",
  "type": "module",
  "bin": {
    "hunch": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": "github:kelbie/hunch",
  "keywords": [
    "lint",
    "code-review",
    "jev",
    "typesafe",
    "agent-skills",
    "github-app"
  ],
  "dependencies": {
    "ai": "7.0.105",
    "@ai-sdk/gateway": "4.0.85",
    "oxc-parser": "0.150.0",
    "parse-diff": "0.12.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.8.0",
    "zod": "4.6.5"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "bun run build"
  }
}
